# ---------------------------------------------------------------------------
# NexusAPI Environment Variables — EXAMPLE (LOCAL DEVELOPMENT)
# ---------------------------------------------------------------------------
# Copy this file to dev/.env and fill in your actual values
# Never commit a real env file to Git
#
# One env file per stack, each beside the compose file that reads it. Compose
# loads it automatically, so no --env-file flag is needed anywhere:
#
#     .env         production   docker-compose.yaml
#     dev/.env     local dev    dev/docker-compose.yaml
#     tests/.env   test/bench   tests/docker-compose.yaml
#
# DJANGO_ENV tells settings.py which stack this is. It must be dev, test or
# prod; anything else refuses to start.

# Environment
DJANGO_ENV=dev

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database
DB_NAME=LMS
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=database-dev
DB_PORT=3306

# MySQL Docker
MYSQL_ROOT_PASSWORD=your-root-password

# Redis
REDIS_URL=redis://redis-dev:6379/0
REDIS_URL_PAGES=redis://redis-dev:6379/2

# Celery
CELERY_BROKER_URL=redis://redis-dev:6379/0
CELERY_RESULT_BACKEND=redis://redis-dev:6379/1

# JWT
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Email
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password


CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
